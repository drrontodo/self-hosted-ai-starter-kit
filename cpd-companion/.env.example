# Copy to .env and fill in. Never commit the real .env.

# Static key Claude Code sessions use to POST session reports (X-API-Key header).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
CPD_API_KEY=

# Dashboard login. Preferred: a bcrypt hash (the plaintext never touches disk):
#   python -c "import bcrypt; print(bcrypt.hashpw(input('password: ').encode(), bcrypt.gensalt()).decode())"
CPD_DASHBOARD_PASSWORD_HASH=
# Fallback if the hash is unset: plaintext password (fine for LAN-only use).
CPD_DASHBOARD_PASSWORD=

# Signs the dashboard session cookie. Optional but recommended (otherwise
# logins reset whenever the container restarts). Generate like the API key.
CPD_SECRET_KEY=

# Timezone for CPD-year boundaries and schedules.
CPD_TZ=Australia/Sydney

# Set to 0 to disable the in-process scheduler (weekly rollup, nightly backup).
# Leave at 1 in normal use; only one process may run the scheduler.
CPD_SCHEDULER=1
