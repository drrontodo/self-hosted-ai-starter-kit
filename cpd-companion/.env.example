# Copy to .env and fill in. Never commit the real .env.

# Static key Claude Code sessions use to POST session reports (X-API-Key header).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
CPD_API_KEY=

# Dashboard login. Preferred: a bcrypt hash (the plaintext never touches disk):
#   python -c "import bcrypt; print(bcrypt.hashpw(input('password: ').encode(), bcrypt.gensalt()).decode())"
CPD_DASHBOARD_PASSWORD_HASH=
# Fallback if the hash is unset: plaintext password (fine for LAN-only use).
CPD_DASHBOARD_PASSWORD=

# Signs the dashboard session cookie. Optional but recommended (otherwise
# logins reset whenever the container restarts). Generate like the API key.
CPD_SECRET_KEY=

# Timezone for CPD-year boundaries and schedules.
CPD_TZ=Australia/Sydney

# Set to 1 once the dashboard is served over HTTPS (Tailscale serve / Caddy)
# so the session cookie is marked Secure. Leave 0 for plain-HTTP LAN access.
CPD_COOKIE_SECURE=0

# Set to 0 to disable the in-process scheduler (weekly rollup, nightly backup).
# Leave at 1 in normal use; only one process may run the scheduler.
CPD_SCHEDULER=1

# Optional: free NCBI API key (raises the PubMed E-utilities rate limit from
# 3 to 10 requests/second) — https://www.ncbi.nlm.nih.gov/account/settings/
CPD_NCBI_API_KEY=

# PBS Schedule Data API (monthly new/changed neurology listings). The default
# base is the public v3 API; if it requires a subscription key from your
# network, the docs at https://data.pbs.gov.au publish a public key — set it
# here and smoke-test with the "run now" button on the Feeds page.
CPD_PBS_API_BASE=https://data-api.health.gov.au/pbs/api/v3
CPD_PBS_SUBSCRIPTION_KEY=

# Google reviews polling (M2). Create an API key in Google Cloud with the
# Places API enabled, and find the practice's Place ID with the Place ID
# finder. Leave blank to rely on manual JSON exports in data/inbox/reviews.
GOOGLE_PLACES_API_KEY=
EAST_NEURO_PLACE_ID=
